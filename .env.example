# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

APP_ENV=development
SECRET_KEY=

# Google Analytics 4 (Data API) OAuth — leave blank to run in
# demo-only mode. The Data Sources page will show
# "Configuration required" until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/data-sources/google/callback
GA4_PROPERTY_ID=

# Not used yet in this build — reserved for the Postgres-backed
# multi-tenant model described in ROADMAP.md.
DATABASE_URL=

# Local token store for the connected Google Analytics account
# (SQLite). Defaults to data/app.db next to this file if unset.
# SECRET_KEY (above) is also used to encrypt the stored tokens at
# rest — set it to a real random value before connecting GA4 for
# real, not just to enable the feature.
TOKEN_STORE_PATH=
